# Port the Express server listens on (default: 4000)
PORT=4000

# Set when running behind a reverse proxy (nginx, Caddy) so the rate
# limiter sees each client's real IP instead of the proxy's. Typically
# "1" (one hop). Leave unset when running standalone.
TRUST_PROXY=

# Optional: Gemini API key for AI-enhanced ticker search.
# Get one at https://aistudio.google.com/
# Leave unset to use Yahoo Finance search only.
GEMINI_API_KEY=
